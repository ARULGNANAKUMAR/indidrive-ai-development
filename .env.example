# IndiDrive AI — environment variable template.
# Copy to .env and fill in values for your machine. Never commit a real
# .env file — see .gitignore.
#
# Every variable below is one this codebase actually reads today
# (verified in docs/PROJECT_AUDIT.md). No API keys, cloud credentials,
# or LLM provider keys are required anywhere in Phase 0 — the project
# has no cloud/remote-AI integration yet.

# --- api/server.py / run.sh -------------------------------------------------
# Port the unified FastAPI app (and app.py) listens on.
PORT=8004

# --- legacy_simulator/server.py ---------------------------------------------
# Comma-separated list of origins allowed to call /api/* when the
# simulator is run standalone (flask-cors). Not used when mounted
# in-process under /simulator via api/server.py.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Standalone legacy_simulator/server.py port, if ever run on its own
# instead of mounted at /simulator (see legacy_simulator/server.py __main__).
# PORT=5000
DEBUG=false

# --- core/modes.py (Phase 0) -------------------------------------------------
# One of: OFFLINE | CARLA | RECORD | TEST | BENCHMARK
INDIDRIVE_MODE=OFFLINE

# --- CARLA -------------------------------------------------------------------
# Host/port are NOT read from the environment today — scripts/carla_test_connection.py
# and scripts/carla_spawn_and_record.py take them as --host/--port CLI flags
# (both default to localhost:2000). See docs/CARLA_SETUP.md. Nothing secret
# lives here — CARLA's default dev server has no auth token.
